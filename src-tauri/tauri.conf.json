{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upstream Releases Tracker",
  "mainBinaryName": "Upstream Releases Tracker",
  "version": "2.0.1",
  "identifier": "page.mukundyedunuthala.upstream-releases-tracker",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Upstream Releases Tracker",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0"
  }
}
